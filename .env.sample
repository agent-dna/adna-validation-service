# ADNA validation service settings.
#   cp .env.sample .env      then fill it in. The server won't start without .env.
# Only this file is read: variables set in the shell are not used.

# Required
AGENTDNA_API_KEY=
PROVENANCE_LAYER_URL=https://chain-connector-2.rubix.net
ADMIN_SERVER_URL=https://agentdna-admin.agentdna.io
# The name of the service's AgentDNA identity. Its ID is printed at start: whitelist it.
ADNA_VALIDATION_SERVICE_IDENTITY=

# Optional: blank means the default
HOST=127.0.0.1
PORT=8810
CBAC_URL=https://cbac-service.agentdna.io
CBAC_ENABLED=true
