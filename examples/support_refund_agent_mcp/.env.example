# AgentDNA
AGENTDNA_API_KEY=
PROVENANCE_LAYER_URL=https://chain-connector-2.rubix.net
ADMIN_SERVER_URL=https://agentdna-admin.agentdna.io
CBAC_URL=https://cbac-service.agentdna.io
CBAC_ENABLED=true
SUPPORT_LEAD_NAME=support-lead
SUPPORT_AGENT_NAME=Support Agent
PAYMENTS_AGENT_NAME=Payments Agent
ADNA_VALIDATION_SERVICE_IDENTITY=Validation Service
# Authentication evidence (optional): shows Stripe and Jira on the dashboard
AGENTDNA_AUTH_EVIDENCE=
AGENTDNA_FINGERPRINT_KEY=

# LLM: openai (OpenAI, or any OpenAI-compatible service) or gemini
LLM_BACKEND=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# For an OpenAI-compatible service, e.g. Ollama: http://127.0.0.1:11434/v1
OPENAI_BASE_URL=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Stripe (test mode). Only Kong uses it, and make_payment.py for setup.
STRIPE_AUTH=Bearer sk_test_...
STRIPE_PAYMENT_INTENT=

# Jira Cloud, through Atlassian's MCP server. Only Kong uses the key.
# JIRA_AUTH: "Basic " + base64 of "email:api_token". Your Atlassian organization's
# admin must allow API tokens for the Rovo MCP server.
JIRA_AUTH=Basic base64-of-email:api_token
JIRA_URL=https://your-site.atlassian.net
JIRA_PROJECT=KAN
